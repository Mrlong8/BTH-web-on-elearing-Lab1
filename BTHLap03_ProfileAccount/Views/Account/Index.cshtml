@{
    ViewData["Title"] = "Index";
}
@model List<BTHLap03_ProfileAccount.Models.Account>

<style>
    /* Cố định kích thước ảnh và chống biến dạng */
    .account-card img {
        width: 100%;
        height: 220px;          /* Cố định chiều cao ảnh */
        object-fit: cover;       /* Tự động cắt tỉa ảnh vừa khung mà không bị méo */
        object-position: center; /* Căn giữa bức ảnh */
    }

    /* Đồng bộ chiều cao giữa các khung thumbnail */
    .account-card {
        margin-bottom: 30px;
    }

    .account-card .thumbnail {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .account-card .caption {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }
</style>

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            @* col-md-4 chia màn hình 12 cột thành 3 phần bằng nhau (12/4 = 3) *@
            <div class="col-md-4 col-sm-6 account-card">
                <div class="thumbnail">
                    <img src="@Url.Content(item.Avatar)" alt="@item.Name" />
                    <div class="caption">
                        <div>
                            <h3>@item.Name</h3>
                            <p>@item.Bio</p>
                        </div>
                        <p>
                            <a asp-controller="Account" asp-action="Profile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>